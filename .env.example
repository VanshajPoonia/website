# Contact form delivery (optional). Without these, the form tells visitors
# to email or call instead, and nothing is lost silently.
RESEND_API_KEY=
# Where new project enquiries are delivered.
CONTACT_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "KreativVantage <forms@kreativvantage.com>".
CONTACT_FROM_EMAIL=
